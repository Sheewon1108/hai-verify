# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=your_bot_token

# Application → General Information → Application ID
DISCORD_CLIENT_ID=your_application_id

# Dev only: Server ID for instant slash command updates (optional)
DISCORD_GUILD_ID=your_test_server_id

# HAI Verify API (Next.js must be running)
HAI_VERIFY_API_URL=http://localhost:3001

# Same value as HAI_INTERNAL_API_KEY in secrets/hai-verify.env (required in production)
HAI_INTERNAL_API_KEY=your_internal_api_key
