{
  "name": "hai-verify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:hai-ic": "next dev --hostname 127.0.0.1 --port 3001",
    "hai-ic:automation": "powershell -ExecutionPolicy Bypass -File ./scripts/hai-ic-automation-start.ps1",
    "hai-ic:keepalive": "powershell -ExecutionPolicy Bypass -File ./scripts/register-hai-ic-autostart.ps1",
    "hai-ic:productization": "node ./scripts/hai-ic-productization-status.cjs",
    "dev:local": "next dev",
    "tunnel": "npx --yes localtunnel --port 3001",
    "local:doctor": "powershell -ExecutionPolicy Bypass -File ./scripts/local-doctor.ps1",
    "access:test-loopback": "powershell -ExecutionPolicy Bypass -File ./scripts/test-access-loopback.ps1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cf": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-cf.ps1",
    "workers:sync-env": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-workers-env.ps1",
    "vault:status": "powershell -ExecutionPolicy Bypass -File ./scripts/vault.ps1 status",
    "vault:migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/vault.ps1 migrate",
    "vault:list": "powershell -ExecutionPolicy Bypass -File ./scripts/vault.ps1 list",
    "backup:restore-point": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-security-restore-point.ps1",
    "sell:one": "powershell -ExecutionPolicy Bypass -File ./scripts/send-one-followup.ps1",
    "hire:pack": "powershell -ExecutionPolicy Bypass -File ./scripts/open-hiring-pack.ps1",
    "warroom:status": "powershell -ExecutionPolicy Bypass -File ./scripts/war-room-status.ps1",
    "warroom:github-secrets": "powershell -ExecutionPolicy Bypass -File ./scripts/open-github-secrets-steps.ps1",
    "pm2:clear-errors": "powershell -ExecutionPolicy Bypass -File ./scripts/clear-pm2-error-logs.ps1",
    "pm2:register-log-cleanup": "powershell -ExecutionPolicy Bypass -File ./scripts/register-pm2-log-cleanup.ps1",
    "user-context:assert": "powershell -ExecutionPolicy Bypass -File ./scripts/lib/assert-user-timezone.ps1",
    "user-context:scenarios": "powershell -ExecutionPolicy Bypass -File ./scripts/test-user-context-scenarios.ps1",
    "user-context:test-us-timezones": "powershell -ExecutionPolicy Bypass -File ./scripts/test-us-timezones-assert.ps1",
    "user-context:readme": "powershell -NoProfile -Command \"Get-Content ./products/hai-user-context/README.md\"",
    "remind:pending-approvals": "node ./scripts/send-pending-approval-reminder.mjs",
    "test:pending-approvals": "node --test ./scripts/test-pending-approval-reminders.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "next": "16.2.6",
    "openai": "^6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.95.0"
  }
}
