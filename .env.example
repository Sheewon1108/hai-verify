# Copy to .env.local and fill in values.

# Optional — OpenAI (verify API)
OPENAI_API_KEY=

# Optional — future real Stripe checkout (server-only secret)
# Prefer a restricted API key (rk_...) with the minimum payment permissions.
# Never commit real Stripe keys; keep /order mock-only until a live integration ships.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare deploy (no browser login — create token at dash.cloudflare.com/profile/api-tokens)
# Template: "Edit Cloudflare Workers" + Account Resources: your account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
