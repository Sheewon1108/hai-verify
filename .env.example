# ============================================================
# HAI Verify / XGOMA — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to GitHub — it is in .gitignore.
# ============================================================

# ------------------------------------------------------------
# User context — confirm with user; never infer from language
# English/en-US does NOT imply a US timezone (Pacific/Mountain/Central/Eastern)
# US=multi-timezone (zone inference FORBIDDEN). Korea=single zone (language != residence).
# ------------------------------------------------------------
USER_COUNTRY=US
USER_TIMEZONE=Pacific Standard Time
USER_REGION=California, US
USER_CONTACT_PHONE=+1-212-555-0147
USER_DISPLAY_LOCALE=en-US

# ------------------------------------------------------------
# OpenAI (optional — for AI-assisted verify features)
# Get key: platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------
# Cloudflare Workers deploy + runtime secrets
# Get token: dash.cloudflare.com/profile/api-tokens
# Template: "Edit Cloudflare Workers"
# Account ID: dash.cloudflare.com → right sidebar
# Upload runtime secrets: npm run workers:sync-env
# ------------------------------------------------------------
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# ------------------------------------------------------------
# Stripe — payment processing
# Get keys: dashboard.stripe.com/apikeys
# Use restricted key (rk_live_) in production for least privilege.
# NEVER put sk_live_ or rk_live_ in code or wrangler.toml.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Product Price IDs (create in dashboard.stripe.com/products)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ------------------------------------------------------------
# API access control
# protected (default) | open (legacy MVP — no API key required)
# ------------------------------------------------------------
HAI_ACCESS_MODE=protected
HAI_ACCESS_LOCAL_BYPASS=true

# ------------------------------------------------------------
# HAI API key signing secret
# Generate: openssl rand -hex 32
# This signs all issued API keys — keep it safe.
# ------------------------------------------------------------
HAI_API_KEY_SECRET=<run: openssl rand -hex 32>

# Internal static key for scripts/CI (optional)
# Generate: openssl rand -hex 24
HAI_INTERNAL_API_KEY=<run: openssl rand -hex 24>
