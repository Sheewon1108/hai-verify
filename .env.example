# Copy to .env.local and fill in values.

# Optional — OpenAI (verify API)
OPENAI_API_KEY=

# Cloudflare deploy (no browser login — create token at dash.cloudflare.com/profile/api-tokens)
# Template: "Edit Cloudflare Workers" + Account Resources: your account
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Stripe — get keys at dashboard.stripe.com/apikeys
# Use restricted key (rk_) in production, test key (sk_test_) for dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public key — safe to expose in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# HAI API key signing secret — generate with: openssl rand -hex 32
HAI_API_KEY_SECRET=
