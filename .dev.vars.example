# Local Wrangler / OpenNext preview — copy to .dev.vars (gitignored)
# Canonical source: ~/secrets/hai-verify.env

OPENAI_API_KEY=sk-proj-...
HAI_ACCESS_MODE=protected
HAI_ACCESS_LOCAL_BYPASS=true
HAI_API_KEY_SECRET=hex32chars...
HAI_INTERNAL_API_KEY=hex24chars...

# WR private rooms (/wr) access keys — generate: openssl rand -hex 24
# Owner key opens 낙서방+복불복, EM key opens 복불복 only. Vault only, never commit.
WR_KEY_OWNER=hex24chars...
WR_KEY_EM=hex24chars...

# Optional Stripe
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...