# Local Wrangler / OpenNext preview — copy to .dev.vars (gitignored)
# Canonical source: ~/secrets/hai-verify.env

OPENAI_API_KEY=sk-proj-...
HAI_ACCESS_MODE=protected
HAI_ACCESS_LOCAL_BYPASS=true
HAI_API_KEY_SECRET=hex32chars...
HAI_INTERNAL_API_KEY=hex24chars...

# Optional Stripe
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
NEXT_PUBLIC_HAI_PAYMENT_LINK=https://buy.stripe.com/...

# Intake delivery
HAI_OPERATIONS_EMAIL=ops@hai-ic.com
RESEND_API_KEY=re_...
HAI_FROM_EMAIL=HAI Intake <onboarding@resend.dev>