{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hai-verify",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // OpenNext copies Next `public/` into `.open-next/assets` at build time.
  // Keep run_worker_first false so /hai-ic-demo.mp4 is served as a static asset
  // before the Next worker (avoids HTML 404 soft-pages for missing media routes).
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hai-verify"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret runtime config (secrets → wrangler secret bulk via npm run workers:sync-env)
  "vars": {
    "HAI_ACCESS_MODE": "protected",
    "HAI_ACCESS_LOCAL_BYPASS": "false"
  }
}
